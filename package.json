{
  "name": "blackjack-audit",
  "version": "1.0.0",
  "license": "MIT",
  "private": true,
  "description": "Provably fair audit — LIQD.com Blackjack",
  "scripts": {
    "test": "npm run test:toolchain",
    "verify": "ts-node tests/verify.ts",
    "simulate": "ts-node src/simulate.ts",
    "rtp": "ts-node src/exact-play.ts",
    "mutate": "ts-node tests/mutate.ts",
    "attack": "ts-node src/cherry-pick-attack.ts",
    "branches": "ts-node src/rng-branch-audit.ts",
    "test:full": "mocha && npm run simulate && SIM_FRESH=1 npm run verify",
    "calibrate": "ts-node src/calibration.ts",
    "test:toolchain": "mocha && npm run verify",
    "verify:standalone": "node verify.js",
    "test:standalone": "node test.js && node verify.js"
  },
  "devDependencies": {
    "@types/mocha": "^10",
    "@types/node": "^22",
    "mocha": "^11",
    "ts-node": "^10",
    "typescript": "^5"
  }
}
